{
  "name": "lacvay",
  "private": true,
  "version": "1.0.0",
  "description": "LACVAY — Batangas City Travel Assistant",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client && npm run build -w server",
    "start": "npm run start -w server",
    "preview": "npm run preview -w client"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "leaflet": "^1.9.4",
    "react-leaflet": "^5.0.0"
  }
}
